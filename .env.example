# Public origin of the deployed site (no trailing slash), used for SEO
# metadata, Open Graph, JSON-LD, sitemap.xml and robots.txt.
# e.g. https://almaprep.conyso.com — falls back to the default in src/lib/siteConfig.ts if unset.
NEXT_PUBLIC_SITE_URL=

# Where the /contact-sales form submits. Set to a Formspree (or similar) form URL
# connected to the Almaprep inbox/Gmail. If left blank, the form falls back to
# opening the visitor's email client pre-filled to partnerships@almaprep.app.
NEXT_PUBLIC_CONTACT_ENDPOINT=
FORMSPREE_FORM_ID=

# ── Auth (REQUIRED in production) ────────────────────────────────────────────
# Signs session JWTs AND derives the Supabase password for every Google-provisioned
# account (see src/lib/auth.ts). Anyone holding it can log in as any Google user,
# so it must be a real random value and must never be committed. The app refuses
# to start in production without it.
#   openssl rand -hex 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. Bypasses RLS — server-only, never NEXT_PUBLIC_. Required for
# the quota counter and tier grants to persist; without it those degrade to
# console logging and the quota stops enforcing (fails open, by design).
SUPABASE_SERVICE_ROLE_KEY=

# ── Local development without a Supabase project ─────────────────────────────
# "true" swaps in fake Supabase clients that accept ANY email/password and mint a
# session. Force-disabled when NODE_ENV=production; never set it on a deploy.
# Leave blank unless you are running with no backing project.
NEXT_PUBLIC_MOCK_AUTH=

# ── Paywall ──────────────────────────────────────────────────────────────────
# "true" turns on monthly interview quotas from src/config/plans.ts. Anything
# else and checkInterviewAllowance() allows every request (no limits enforced).
# Needs SUPABASE_SERVICE_ROLE_KEY to be set to have any effect.
PAYWALL_ENABLED=

GEMINI_API_KEY=
GROQ_API_KEY=
INTERVIEW_GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Rate limiting (Upstash Redis) ────────────────────────────────────────────
# Makes API rate limits authoritative across serverless invocations. Without
# these, the limiter falls back to per-instance in-memory (fine for local dev,
# NOT effective on Vercel/serverless). Create a free DB at upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Product analytics (PostHog) ──────────────────────────────────────────────
# Funnel/conversion tracking. Absent = analytics is a no-op. Free tier at posthog.com.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Error monitoring (Sentry) ────────────────────────────────────────────────
# Absent DSN = Sentry is a no-op. NEXT_PUBLIC_SENTRY_DSN covers browser + server;
# only set SENTRY_DSN if you want a different server-side project. From sentry.io.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
